PORT=4000
CORS_ORIGINS=http://localhost:3000

# 각자 .env에서 개인 DB 비밀번호를 설정하세요.
POSTGRES_PASSWORD=

# 위 POSTGRES_PASSWORD와 동일한 비밀번호를 입력하세요.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/pot?schema=public

# 개발 RDS의 pot_dev 시딩 시에만 실제 RDS 엔드포인트를 설정하세요.
# 승인 값은 공용 또는 상시 .env에 저장하지 말고 시딩을 실행하는 세션에서만 설정하세요.
# POT_DEV_RDS_HOST=your-development-db.ap-northeast-2.rds.amazonaws.com
# POT_DEV_SEED_CONFIRMATION=pot_dev

# Access Token 서명용 비밀값입니다. 각자 .env에 충분히 긴 무작위 문자열을 설정하세요.
JWT_ACCESS_SECRET=

# Refresh Token 서명용 비밀값입니다. Access Token 비밀값과 다른 충분히 긴 무작위 문자열을 설정하세요.
JWT_REFRESH_SECRET=
