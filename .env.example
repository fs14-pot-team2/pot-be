PORT=4000
CORS_ORIGINS=http://localhost:3000

# 각자 .env에서 개인 DB 비밀번호를 설정하세요.
POSTGRES_PASSWORD=

# 위 POSTGRES_PASSWORD와 동일한 비밀번호를 입력하세요.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/pot?schema=public

# Access Token 서명용 비밀값입니다. 각자 .env에 충분히 긴 무작위 문자열을 설정하세요.
JWT_ACCESS_SECRET=

# Refresh Token 서명용 비밀값입니다. Access Token 비밀값과 다른 충분히 긴 무작위 문자열을 설정하세요.
JWT_REFRESH_SECRET=